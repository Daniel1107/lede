# =============================================================================
# 骨架种子 v3.1 —— 首跑验证专用（无插件，先保编译链路 100% 通）
# 所有非常见符号均已对照 coolsnowwolf/lede master 源码核实：
#   CONFIG_VMDK_IMAGES      <- config/Config-images.in L294（bool "Build VMware image files (VMDK)"，
#                              depends on TARGET_x86 && GRUB_IMAGES||GRUB_EFI_IMAGES）
#   CONFIG_TARGET_IMAGES_GZIP <- config/Config-images.in L313
#   CONFIG_GRUB_EFI_IMAGES    <- config/Config-images.in L226
#   combined-efi.vmdk 产出    <- target/linux/x86/image/Makefile L117/L143-145
#   CONFIG_TARGET_ROOTFS_PARTSIZE <- config/Config-images.in L332（3月教程建议 1024MiB）
# 插件段暂缺：首轮绿了以后，经 SSH 面板(ssh=true) menuconfig 或回填 3 月 .config 再合并进来
# =============================================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
